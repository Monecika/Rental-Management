        <mxCell id="180" value="Confirm Reservation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="317.5" y="460" width="155" height="30" as="geometry" />
        </mxCell>
        <mxCell id="182" value="Cancel Reservation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="282" y="850" width="176" height="30" as="geometry" />
        </mxCell>
        <mxCell id="183" value="&lt;h1&gt;HeartBeat process&lt;/h1&gt;&lt;div&gt;Building agent sends a request with his data to the rental agent, this is used for 2 causes:&lt;/div&gt;&lt;div&gt;1. To register the building&lt;/div&gt;&lt;div&gt;2. To keep the data up to date for every rental agent&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="-560" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="184" value="&lt;h1&gt;ListBuilding process&lt;/h1&gt;&lt;div&gt;Client agents sends a request to the rental agent to get a list of buildings&lt;/div&gt;&lt;div&gt;Rental agent instead of fetching it from the building, it returns the list that he has saved in memory, because every 5 seconds that data gets refreshed making it relatively fresh for returning&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="770" y="-285" width="470" height="120" as="geometry" />
        </mxCell>
        <mxCell id="185" value="&lt;h1&gt;Rental process&lt;/h1&gt;&lt;div&gt;Client agents sends a request to rental agent to reserve a room&lt;/div&gt;&lt;div&gt;Rental agent forwards this request to Building agent&lt;/div&gt;&lt;div&gt;Building agent check if the room is available, updates its data, and sends back to Rental agent a response&lt;/div&gt;&lt;div&gt;Rental Agent sends that response back to the Client agent&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="186" value="&lt;h1&gt;Confirmation process&lt;/h1&gt;&lt;div&gt;Client agents sends a request to confirm the reservation to the Rental Agent&lt;/div&gt;&lt;div&gt;Rental agent check if he has that UUID stored, and confirms the reservation&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="524.5" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="187" value="&lt;h1&gt;Cancelation process&lt;/h1&gt;&lt;div&gt;Client agents sends a request to cancel the reservation to the Rental Agent&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;Rental agent check if he has the UUID stored, if the id is missing, Rental agents sends back an error&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;If Rental agent ahas the id stored forwards the request to Buildign agent and updates its own storage&lt;/div&gt;&lt;div&gt;Building agent updates its own data about the room reservation&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="820" y="1030" width="480" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
